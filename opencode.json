{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "read": {
            "*": "allow",
            "*.env*": "ask",
            "*.env.example": "allow",
            "*.env.template": "allow"
        },
        "edit": {
            "*": "allow",
            "*.env*": "ask",
            "*.env.example": "ask",
            "*.env.template": "ask"
        },
        "external_directory": {
            "*": "ask",
            "~/.config/opencode/**": "allow",
            "~/.cache/opencode/**": "allow"
        },
        "bash": {
            "*": "ask",
            "Write-Output*": "allow",
            "echo*": "allow",
            "$*": "allow",
            "Test-Path*": "allow",
            "Get-ChildItem*": "allow",
            "Get-Content*": "allow",
            "Get-Command*": "allow",
            "Select-Object*": "allow",
            "Where-Object*": "allow",
            "Out-Null*": "allow",
            "dir*": "allow",
            "ls*": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git branch*": "allow",
            "git show*": "allow",
            "git blame*": "allow"
        }
    },
    "mcp": {
        "codebase-memory": {
            "type": "local",
            "command": [
                "C:/Users/andre/.local/bin/codebase-memory-mcp.exe"
            ],
            "enabled": true,
            "environment": {
                "CBM_MEM_BUDGET_MB": "4096"
            }
        }
    }
}