{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "hormiga-dev",
    "agent": {
        "plan": {
            "disable": true
        },
        "build": {
            "disable": true
        }
    },
    "permission": {
        "read": {
            "*": "allow",
            "*.env*": "ask",
            "*.env.example": "allow",
            "*.env.template": "allow"
        },
        "edit": {
            "*": "ask",
            "*.md": "allow",
            "*.txt": "allow",
            ".opencode/**": "allow",
            ".superpowers/**": "allow",
            "docs/**": "allow",
            "*.env*": "ask"
        },
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "external_directory": {
            "*": "ask",
            "~/.config/opencode/**": "allow",
            "~/.cache/opencode/**": "allow"
        },
        "bash": {
            "*": "ask",
            "Get-ChildItem*": "allow",
            "Get-Content*": "allow",
            "Get-Item*": "allow",
            "Get-Command*": "allow",
            "Test-Path*": "allow",
            "Resolve-Path*": "allow",
            "Split-Path*": "allow",
            "Join-Path*": "allow",
            "Select-Object*": "allow",
            "Where-Object*": "allow",
            "Sort-Object*": "allow",
            "ForEach-Object*": "allow",
            "Format-Table*": "allow",
            "Format-List*": "allow",
            "Out-String*": "allow",
            "Out-Null*": "allow",
            "ConvertTo-Json*": "allow",
            "ConvertFrom-Json*": "allow",
            "Measure-Object*": "allow",
            "Get-Date*": "allow",
            "Get-Random*": "allow",
            "Get-Location*": "allow",
            "Push-Location*": "allow",
            "Pop-Location*": "allow",
            "Select-String*": "allow",
            "dir*": "allow",
            "ls*": "allow",
            "cat*": "allow",
            "head*": "allow",
            "tail*": "allow",
            "wc*": "allow",
            "rg *": "allow",
            "grep *": "allow",
            "which*": "allow",
            "echo*": "allow",
            "Write-Output*": "allow",
            "pwd*": "allow",
            "git *": "allow",
            "git commit*": "ask",
            "git push*": "ask",
            "git pull*": "ask",
            "git fetch*": "ask",
            "git checkout*": "ask",
            "git switch*": "ask",
            "git merge*": "ask",
            "git rebase*": "ask",
            "git reset*": "ask",
            "git clean*": "ask",
            "git stash*": "ask",
            "git cherry-pick*": "ask",
            "git revert*": "ask",
            "git tag*": "ask",
            "git clone*": "ask",
            "git submodule*": "ask",
            "pnpm test*": "allow",
            "pnpm run *": "allow",
            "pnpm lint*": "allow",
            "pnpm build*": "allow",
            "npm test*": "allow",
            "npm run *": "allow",
            "bun test*": "allow",
            "bun run *": "allow",
            "node *": "allow",
            "python *": "allow",
            "python3 *": "allow",
            "pytest *": "allow",
            "ruff *": "allow",
            "eslint *": "allow",
            "tsc *": "allow",
            "cargo test*": "allow",
            "cargo check*": "allow",
            "cargo clippy*": "allow",
            "bash *superpowers*": "allow",
            "& *superpowers*": "allow",
            "Remove-Item*": "ask",
            "rm *": "ask",
            "Invoke-Expression*": "ask",
            "iex*": "ask",
            "Start-Process*": "ask",
            "docker*": "ask",
            "docker-compose*": "ask",
            "kubectl*": "ask",
            "ssh*": "ask",
            "scp*": "ask",
            "rsync*": "ask",
            "pnpm add*": "ask",
            "pnpm install*": "ask",
            "npm install*": "ask",
            "npx ng*": "allow",
            "npx eslint*": "allow",
            "npx prettier*": "allow",
            "npx --no-install playwright*": "allow",
            "npx *": "ask",
            "playwright-cli*": "allow",
            "New-Item*": "ask",
            "Set-Content*": "ask",
            "Add-Content*": "ask",
            "Copy-Item*": "ask",
            "Move-Item*": "ask",
            "Rename-Item*": "ask",
            "Set-Content *.env*": "ask",
            "Add-Content *.env*": "ask"
        }
    },
    "plugin": [
        "~/.config/opencode/node_modules/superpowers",
        "~/.config/opencode/node_modules/@dietrichgebert/ponytail"
    ],
    "mcp": {
        "figma-xintec": {
            "type": "local",
            "command": [
                "cmd",
                "/c",
                "npx",
                "-y",
                "figma-developer-mcp",
                "--figma-api-key={file:.keys/.figma-api-key}",
                "--stdio"
            ],
            "enabled": false
        },
        "stitch-cargoability": {
            "type": "remote",
            "url": "https://stitch.googleapis.com/mcp",
            "enabled": false,
            "headers": {
                "X-Goog-Api-Key": "{file:.keys/.stitch-cargoability-api-key}"
            }
        },
        "stitch-personal": {
            "type": "remote",
            "url": "https://stitch.googleapis.com/mcp",
            "enabled": false,
            "headers": {
                "X-Goog-Api-Key": "{file:.keys/.stitch-personal-api-key}"
            }
        }
    }
}
