{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "read": {
            "*": "allow",
            "*.env*": "ask",
            "*.env.example": "allow",
            "*.env.template": "allow"
        },
        "edit": {
            "*": "ask",
            "*.md": "allow",
            "*.txt": "allow",
            ".opencode/**": "allow",
            ".superpowers/**": "allow",
            "docs/**": "allow",
            "*.env*": "ask"
        },
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "external_directory": {
            "*": "ask",
            "~/.config/opencode/**": "allow",
            "~/.cache/opencode/**": "allow"
        },
        "bash": {
            "*": "ask",
            "Get-ChildItem*": "allow",
            "Get-Content*": "allow",
            "Get-Item*": "allow",
            "Get-Command*": "allow",
            "Test-Path*": "allow",
            "Resolve-Path*": "allow",
            "Split-Path*": "allow",
            "Join-Path*": "allow",
            "Select-Object*": "allow",
            "Where-Object*": "allow",
            "Sort-Object*": "allow",
            "ForEach-Object*": "allow",
            "Format-Table*": "allow",
            "Format-List*": "allow",
            "Out-String*": "allow",
            "Out-Null*": "allow",
            "ConvertTo-Json*": "allow",
            "ConvertFrom-Json*": "allow",
            "Measure-Object*": "allow",
            "Get-Date*": "allow",
            "Get-Random*": "allow",
            "Get-Location*": "allow",
            "Push-Location*": "allow",
            "Pop-Location*": "allow",
            "Select-String*": "allow",
            "dir*": "allow",
            "ls*": "allow",
            "cat*": "allow",
            "head*": "allow",
            "tail*": "allow",
            "wc*": "allow",
            "find*": "allow",
            "which*": "allow",
            "echo*": "allow",
            "Write-Output*": "allow",
            "pwd*": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git branch*": "allow",
            "git show*": "allow",
            "git blame*": "allow",
            "pnpm test*": "allow",
            "pnpm run *": "allow",
            "pnpm build*": "allow",
            "npm test*": "allow",
            "npm run *": "allow",
            "bun test*": "allow",
            "bun run *": "allow",
            "node *": "allow",
            "python *": "allow",
            "python3 *": "allow",
            "pytest *": "allow",
            "ruff *": "allow",
            "eslint *": "allow",
            "tsc *": "allow",
            "cargo test*": "allow",
            "cargo check*": "allow",
            "cargo clippy*": "allow",
            "bash *superpowers*": "allow",
            "& *superpowers*": "allow",
            "Remove-Item*": "ask",
            "rm *": "ask",
            "Invoke-Expression*": "ask",
            "iex*": "ask",
            "Start-Process*": "ask",
            "docker*": "ask",
            "docker-compose*": "ask",
            "kubectl*": "ask",
            "ssh*": "ask",
            "scp*": "ask",
            "rsync*": "ask",
            "pnpm add*": "ask",
            "pnpm install*": "ask",
            "npm install*": "ask",
            "npx *": "ask",
            "New-Item*": "ask",
            "Set-Content*": "ask",
            "Add-Content*": "ask",
            "Copy-Item*": "ask",
            "Move-Item*": "ask",
            "Rename-Item*": "ask",
            "Set-Content *.env*": "ask",
            "Add-Content *.env*": "ask"
        }
    },
    "mcp": {
        "codebase-memory": {
            "type": "local",
            "command": [
                "C:/Users/andre/.local/bin/codebase-memory-mcp.exe"
            ],
            "enabled": true,
            "environment": {
                "CBM_MEM_BUDGET_MB": "4096"
            }
        }
    }
}